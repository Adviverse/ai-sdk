{
  "name": "@adviverse/ai",
  "version": "0.1.0",
  "description": "Adviverse sponsored suggestions for AI chat apps (web or Node): contextual native ads from client-side keywords, never raw chat text. Markdown + DOM render helpers, bill-on-view impressions.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "keywords": [
    "adviverse",
    "ads",
    "ai",
    "chat",
    "llm",
    "native-ads",
    "sponsored"
